# Copy to .env. Names map to src/sqlscout/config.py (SQ_ prefix).
SQ_DB_PATH=data/shop.db

# Model (leave "none" to use only the SQL console)
SQ_LLM_PROVIDER=none               # none | anthropic | openai | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SQ_OLLAMA_URL=http://localhost:11434/v1
# SQ_OLLAMA_MODEL=llama3.1:8b

# Optional: require this key (X-API-Key header) for /api/ask and /api/sql
# SQ_API_KEY=

# Optional: write one JSON line per agent run (no result rows) to this directory
# SQ_TRACE_DIR=traces
